# Dùng khi build (npm run build) — Cloudflare Pages đọc file này, không cần đặt biến trên dashboard.
# Địa chỉ trang (canonical, sitemap, ảnh chia sẻ Facebook)
VITE_SITE_URL=https://portlogistics.ose.vn
# API chính: Worker ose-failover (home server trước, Render khi home lỗi)
VITE_API_BASE=https://api-portlogistics.ose.vn
# Dự phòng phía trình duyệt: gọi thẳng Render nếu Worker không trả lời
VITE_API_FALLBACK=https://ose-portlogistics-backend.onrender.com
