# Frontend build-time variables (Vite). Copy to .env.local for `npm run dev`.
VITE_SITE_URL=https://portlogistics.ose.vn
# Empty = same origin (/api is proxied by Nginx or the Vite dev server)
VITE_API_BASE=
# Optional second API base tried when the first is unreachable (e.g. the Render backend)
VITE_API_FALLBACK=
